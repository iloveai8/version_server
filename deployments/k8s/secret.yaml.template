# Kubernetes Secret 配置模板
#
# Game Slots Version Server 敏感配置
#
# 使用方法：
# 1. 修改 base64 编码的密码
# 2. kubectl apply -f secret.yaml

apiVersion: v1
kind: Secret
metadata:
  name: game-slots-vsn-secret
  namespace: default
type: Opaque
data:
  # Redis 密码 (使用 base64 编码)
  # 示例: echo -n "your_password" | base64
  redis-password: Y2hhbmdlX21lX3lvdXJfcGFzc3dvcmQ=

  # 其他敏感配置可以在这里添加
  # api-key: <base64_encoded_api_key>
  # jwt-secret: <base64_encoded_jwt_secret>
